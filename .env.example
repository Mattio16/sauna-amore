# --- Database (Neon) ---
# Create a free Postgres at https://neon.tech → copy the connection string.
# Use the POOLED connection string for DATABASE_URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# --- Auth ---
# Generate secret with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# --- Image uploads (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=""

# --- Admin user (used by `npx prisma db seed`) ---
ADMIN_EMAIL="matthew@tesseract.fi"
ADMIN_PASSWORD="choose-a-strong-password"

# --- Automatic translation (DeepL) ---
DEEPL_API_KEY=""

# Order email notifications (optional — https://resend.com)
RESEND_API_KEY=""
ORDER_EMAIL_TO="info@saunaamore.it"
# After verifying saunaamore.it in Resend, e.g.: "Sauna Amore <ordini@saunaamore.it>"
ORDER_EMAIL_FROM=""
